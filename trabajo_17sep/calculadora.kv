#:kivy 2.0.0

# 1. Botones numéricos (Gris claro)
<NumButton@Button>:
    font_size: '28sp'
    bold: True
    color: 0.15, 0.15, 0.2, 1
    background_normal: ''
    background_color: 0.92, 0.93, 0.96, 1

# 2. Botones de operaciones (Azul elegante)
<OpButton@Button>:
    font_size: '28sp'
    bold: True
    color: 1, 1, 1, 1
    background_normal: ''
    background_color: 0.25, 0.48, 0.82, 1

# 3. Botón de borrado/clear (Rojo coral)
<ClearButton@Button>:
    font_size: '28sp'
    bold: True
    color: 1, 1, 1, 1
    background_normal: ''
    background_color: 0.88, 0.32, 0.32, 1

# 4. Botón de resultado (Verde esmeralda)
<EqualButton@Button>:
    font_size: '28sp'
    bold: True
    color: 1, 1, 1, 1
    background_normal: ''
    background_color: 0.2, 0.68, 0.45, 1

<CalculatorLayout>:
    orientation: 'vertical'
    padding: 12
    spacing: 10
    canvas.before:
        Color:
            rgba: 0.12, 0.14, 0.18, 1  # Fondo oscuro tipo Dark Theme
        Rectangle:
            pos: self.pos
            size: self.size

    # Fila Superior: Pantalla (Display) + Botón 'C'
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: 0.22
        spacing: 10

        TextInput:
            text: root.display_text
            font_size: '38sp'
            readonly: True
            halign: 'right'
            multiline: False
            background_normal: ''
            background_color: 0.98, 0.98, 1, 1
            foreground_color: 0.1, 0.1, 0.15, 1
            padding: [12, (self.height - self.line_height) / 2]

        ClearButton:
            text: 'C'
            size_hint_x: 0.3
            on_press: root.on_button_press(self.text)

    # Grilla de Teclado: 4 columnas × 4 filas
    GridLayout:
        cols: 4
        rows: 4
        spacing: 10
        size_hint_y: 0.78

        # Fila 1
        NumButton:
            text: '7'
            on_press: root.on_button_press(self.text)
        NumButton:
            text: '8'
            on_press: root.on_button_press(self.text)
        NumButton:
            text: '9'
            on_press: root.on_button_press(self.text)
        OpButton:
            text: '*'
            on_press: root.on_button_press(self.text)

        # Fila 2
        NumButton:
            text: '4'
            on_press: root.on_button_press(self.text)
        NumButton:
            text: '5'
            on_press: root.on_button_press(self.text)
        NumButton:
            text: '6'
            on_press: root.on_button_press(self.text)
        OpButton:
            text: '/'
            on_press: root.on_button_press(self.text)

        # Fila 3
        NumButton:
            text: '1'
            on_press: root.on_button_press(self.text)
        NumButton:
            text: '2'
            on_press: root.on_button_press(self.text)
        NumButton:
            text: '3'
            on_press: root.on_button_press(self.text)
        OpButton:
            text: '-'
            on_press: root.on_button_press(self.text)

        # Fila 4
        NumButton:
            text: '0'
            on_press: root.on_button_press(self.text)
        NumButton:
            text: '.'
            on_press: root.on_button_press(self.text)
        EqualButton:
            text: '='
            on_press: root.on_button_press(self.text)
        OpButton:
            text: '+'
            on_press: root.on_button_press(self.text)